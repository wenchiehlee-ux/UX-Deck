{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "UX-Deck Unified Tokens",
  "version": "1.0.0",
  "description": "Cross-project design tokens for sibling repositories (mkdocs-life, GoogleAlertManager, YoutubeAudio.Fetch, mkdocs-investment, HomeAssistant TV)",
  "spacing": {
    "2xs": "4px",
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "radii": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "profiles": {
    "mkdocs-life": {
      "theme": "Warm Editorial",
      "primary": "#0d9488",
      "surface": "#faf8f5",
      "accent": "#e07a5f",
      "text": "#292524",
      "textMuted": "#78716c",
      "purpose": "Life logging, reflections, knowledge gardening"
    },
    "google-alert-manager": {
      "theme": "SaaS Signal Intelligence",
      "primary": "#4f46e5",
      "surface": "#f8fafc",
      "accent": "#06b6d4",
      "text": "#0f172a",
      "textMuted": "#64748b",
      "purpose": "Alert feeds triage, keyword rules, rapid scanning"
    },
    "youtube-audio-fetch": {
      "theme": "Atmospheric Media Dark",
      "primary": "#8b5cf6",
      "surface": "#0f0f13",
      "accent": "#06b6d4",
      "highlight": "#ec4899",
      "text": "#f4f4f5",
      "textMuted": "#a1a1aa",
      "purpose": "Audio extractor, player drawer, tactile queue controls"
    },
    "mkdocs-investment": {
      "theme": "Fintech Navy & High-Density Metrics",
      "primary": "#2563eb",
      "surface": "#0a0e17",
      "accent": "#10b981",
      "gainTW": "#ef4444",
      "lossTW": "#22c55e",
      "text": "#f1f5f9",
      "textMuted": "#94a3b8",
      "purpose": "Financial reports, investment research, KPI summary grids"
    },
    "homeassistant-tv": {
      "theme": "10-foot Frosted HUD Overlay",
      "surfaceScrim": "rgba(10, 10, 16, 0.82)",
      "surfaceCard": "rgba(25, 30, 45, 0.92)",
      "borderFocus": "#38bdf8",
      "text": "#ffffff",
      "textMuted": "#cbd5e1",
      "purpose": "Android TV living room notifications, glanceable, D-pad focusable",
      "animalMascot": {
        "species": "Sentinel Guard Dog / Night Sentinel",
        "symbolId": "icon-sentinel-tv",
        "rationale": "Loyal home protection, large eyes and pricked ears instantly recognizable from 3-4 meters away"
      }
    }
  },
  "iconography": {
    "sizes": {
      "xs": "14px",
      "sm": "18px",
      "md": "24px",
      "lg": "32px",
      "xl": "48px",
      "tv": "64px"
    },
    "strokes": {
      "thin": "1.25px",
      "normal": "1.75px",
      "bold": "2.25px"
    },
    "mascots": {
      "mkdocs-life": {
        "name": "Mindful Forest Deer",
        "id": "icon-deer-life",
        "significance": "Serenity, reflective reading, natural rhythm"
      },
      "google-alert-manager": {
        "name": "Peregrine Radar Falcon",
        "id": "icon-falcon-radar",
        "significance": "High-altitude scan, swift target lock, sharp signal triage"
      },
      "youtube-audio-fetch": {
        "name": "Soundwave Singing Whale",
        "id": "icon-whale-sonic",
        "significance": "Deep oceanic audio resonance, harmonic frequency curves"
      },
      "mkdocs-investment": {
        "name": "Geometric Origami Bull & Defensive Bear",
        "ids": ["icon-bull-fintech", "icon-bear-defense"],
        "significance": "Upward alpha momentum paired with disciplined downside protection"
      },
      "homeassistant-tv": {
        "name": "Living Room Sentinel Guardian",
        "id": "icon-sentinel-tv",
        "significance": "10-foot glanceable home protection, high-contrast silhouette"
      }
    }
  }
}

